# Copy to .env and fill in. Never commit .env.

# Django
# Every key below must be at least 64 bytes of randomness. Generate each one with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# The server refuses to start (dev and prod) when a key is shorter than 64 bytes or still says change-me.
SECRET_KEY=change-me-generate-64-random-bytes
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
LOG_LEVEL=INFO

# JWT_SIGNING_KEY signs access tokens (HS256). EMAIL_HASH_KEY keys the HMAC of emails and verification codes.
# Use a different key for each.
JWT_SIGNING_KEY=change-me-generate-64-random-bytes
EMAIL_HASH_KEY=change-me-generate-64-random-bytes

# PostgreSQL 18 database (production must use the same major version) built from docs/nudge_schema_v3_1_no_pgvector.sql. migrate is never run on it.
DATABASE_URL=postgres://postgres:YOUR_PASSWORD@localhost:5432/nudge

# pytest database. Dropped and rebuilt every test session from the two SQL files below.
# Must be on localhost or 127.0.0.1 and end with _test; the builder refuses anything else.
# The role needs CREATEDB. postgres is used for now; a limited nudge_test_runner role comes at deployment.
TEST_DATABASE_URL=postgres://postgres:YOUR_PASSWORD@localhost:5432/nudge_test
NUDGE_SCHEMA_SQL=docs/nudge_schema_v3_1_no_pgvector.sql
NUDGE_SEED_SQL=docs/nudge_seed.sql

# Cache for rate limits and verification codes.
# locmemcache:// works only with one process (runserver). Use redis://localhost:6379/0 when Redis is installed.
CACHE_URL=locmemcache://

# Frontend origin (Vite dev server). CORS and CSRF trust only this origin.
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173

# Reverse proxies whose X-Forwarded-For is trusted (comma-separated IPs). Empty in development.
TRUSTED_PROXIES=

# Email: consolemail:// prints emails to the terminal. Later: smtp+tls://user:password@smtp.example.com:587
EMAIL_URL=consolemail://
DEFAULT_FROM_EMAIL=Nudge <no-reply@localhost>

# Production only
# CSRF_COOKIE_DOMAIN=.example.com
# SECURE_SSL_REDIRECT=True
